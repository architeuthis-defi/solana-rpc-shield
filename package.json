{
  "name": "solana-rpc-shield",
  "version": "0.1.0",
  "description": "Resilient RPC + transaction-reliability SDK for Solana dApps — health-scored multi-endpoint failover, Jito relay routing, dynamic fees, OpenTelemetry, and a diagnostics CLI. Built on @solana/web3.js v2 pluggable transports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rpc-shield": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:sim": "vitest run test/sim",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "cli": "tsx src/cli/index.ts"
  },
  "peerDependencies": {
    "@solana/web3.js": "^2.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@solana/kit": "^6.9.0",
    "@solana/web3.js": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "solana",
    "rpc",
    "failover",
    "reliability",
    "jito",
    "web3js",
    "transport",
    "opentelemetry"
  ]
}
